# Copy to .env and adjust. No API key is needed: the LLM and embeddings run locally in Ollama.
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen3.5:4b
EMBED_MODEL=nomic-embed-text
DB_URL=jdbc:postgresql://localhost:5433/scamshield
DB_USER=scamshield
DB_PASSWORD=scamshield
LLM_TIMEOUT_SECONDS=45
RATE_LIMIT_PER_MINUTE=20
